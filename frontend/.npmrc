# ============================================
# NPM CONFIGURATION FOR SCHEDULE PRO
# ============================================

# ✅ Allow legacy peer dependencies (React 19 compatibility)
legacy-peer-deps=true

# ✅ Use latest stable npm
registry=https://registry.npmjs.org/

# ✅ Log level for debugging (optional)
loglevel=notice

# ✅ Save exact versions (optional)
save-exact=false