# ============================================
# NPM CONFIGURATION FOR CI/CD (RENDER)
# ============================================

# Fix peer dependency conflicts (React 19)
legacy-peer-deps=true

# Skip security audit (faster builds)
audit=false

# Skip funding messages (cleaner logs)
fund=false

# Hide progress bar (cleaner logs)
progress=false

# Use official npm registry
registry=https://registry.npmjs.org/

# Enable strict SSL (security)
strict-ssl=true